---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { base, byNewest, dicts, readingTime, fmtDate, type Lang } from '../i18n';
import { TEMAS } from '../content.config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const items = (await getCollection('blog')).sort(byNewest);
const title = `${t.blog.title} · Margarita Margenat`;
// Solo los temas que tienen algún artículo, en el orden fijo de TEMAS
const temas = TEMAS.filter((k) => items.some((p) => p.data.temas.includes(k)));
---
<Base lang={lang} t={t} title={title} description={t.blog.description} path="blog/">
  <main class="wrap narrow page-head">
    <h1 class="title">{t.blog.title}</h1>
    {temas.length > 1 && (
      <details class="temas" id="temas">
        <summary><span class="caps">{t.blog.filtros}</span><span class="caps sel" id="tema-sel"></span></summary>
        <nav aria-label={t.blog.temasTitle}>
          <button type="button" data-tema="" aria-pressed="true">{t.blog.todos}</button>
          {temas.map((k) => <button type="button" data-tema={k} aria-pressed="false">{t.blog.temas[k]}</button>)}
        </nav>
      </details>
    )}
    <ul class="resources" id="articulos">
      {items.map((p) => (
        <li data-temas={p.data.temas.join(' ')}>
          <span class="caps">{fmtDate(p.data.date, lang)} · {readingTime(p.body ?? '')} {t.blog.minRead}{p.data.lang !== lang && t.recursos.inLang ? ` · ${t.recursos.inLang}` : ''}</span>
          <h2><a href={`${base(p.data.lang)}blog/${p.id}/`}>{p.data.title}</a></h2>
          <p>{p.data.summary[lang]}</p>
          <a href={`${base(p.data.lang)}blog/${p.id}/`} class="link">{t.blog.read}</a>
        </li>
      ))}
    </ul>
  </main>
  <script>
    // Filtro por tema, plegado bajo "Filtros": oculta los artículos que no tienen el tema elegido,
    // que se muestra junto a "Filtros" y va en la URL (#tema=culpa) para poder enlazarlo.
    const nav = document.getElementById('temas') as HTMLDetailsElement | null;
    if (nav) {
      const buttons = Array.from(nav.querySelectorAll<HTMLButtonElement>('button'));
      const items = Array.from(document.querySelectorAll<HTMLLIElement>('#articulos li'));
      const sel = document.getElementById('tema-sel')!;
      const apply = (tema: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tema === tema)));
        items.forEach((li) => { li.hidden = tema !== '' && !(li.dataset.temas ?? '').split(' ').includes(tema); });
        sel.textContent = tema ? ` · ${buttons.find((b) => b.dataset.tema === tema)?.textContent ?? ''}` : '';
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        const tema = b.dataset.tema ?? '';
        apply(tema);
        history.replaceState(null, '', tema ? `#tema=${tema}` : location.pathname);
      }));
      const fromHash = new URLSearchParams(location.hash.slice(1)).get('tema') ?? '';
      if (fromHash && buttons.some((b) => b.dataset.tema === fromHash)) { apply(fromHash); nav.open = true; }
    }
  </script>
</Base>
