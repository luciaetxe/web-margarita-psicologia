---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { base, dicts, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const home = base(lang);
const items = (await getCollection('recursos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const title = `${t.recursos.title} · Margarita Margenat`;
---
<Base lang={lang} t={t} title={title} description={t.recursos.intro} path="recursos/">
  <main class="wrap narrow page-head">
    <h1 class="title">{t.recursos.title}</h1>
    <p class="intro">{t.recursos.intro}</p>
    <ul class="resources">
      {items.map((r) => (
        <li>
          <span class="caps">{r.data.kind[lang]}{r.data.duration ? ` · ${r.data.duration}` : ''}{r.data.lang !== lang && t.recursos.inLang ? ` · ${t.recursos.inLang}` : ''}</span>
          <h2><a href={`${base(r.data.lang)}recursos/${r.id}/`}>{r.data.title}</a></h2>
          <p>{r.data.summary[lang]}</p>
          <a href={`${base(r.data.lang)}recursos/${r.id}/`} class="link">{r.data.audio ? t.recursos.listen : t.recursos.read}</a>
        </li>
      ))}
    </ul>
  </main>
</Base>
