---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import EncuentroFoto from './EncuentroFoto.astro';
import { base, byNewest, dicts, waLink, EMAIL, INSTAGRAM, type Lang } from '../i18n';
import precios from '../data/precios.json';
import heroWide from '../assets/hero-wide.jpg';
import heroTall from '../assets/hero-tall.jpg';
import retrato from '../assets/margarita.jpeg';
import { getCollection } from 'astro:content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const home = base(lang);
const recursos = (await getCollection('recursos')).sort(byNewest).slice(0, 3);

// Hero con dirección de arte: recorte apaisado en escritorio, vertical en móvil.
const wideAvif = await getImage({ src: heroWide, format: 'avif', widths: [1200, 1800, 2600], sizes: '100vw' });
const wideWebp = await getImage({ src: heroWide, format: 'webp', widths: [1200, 1800, 2600], sizes: '100vw' });
const wideJpg  = await getImage({ src: heroWide, format: 'jpg', width: 1800 });
const tallAvif = await getImage({ src: heroTall, format: 'avif', widths: [600, 900, 1200], sizes: '100vw' });
const tallWebp = await getImage({ src: heroTall, format: 'webp', widths: [600, 900, 1200], sizes: '100vw' });
const site = Astro.site!.toString().replace(/\/$/, '');
const wa = waLink(t.wa.msg);
// Encuentros (talleres y retiros) en el idioma de la página: próximos primero.
const encuentros = (await getCollection('encuentros'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => Number(b.data.upcoming) - Number(a.data.upcoming) || byNewest(a, b));
const encHref = (e: (typeof encuentros)[number]) => e.data.url ?? `${home}encuentros/${e.id.replace(/^(ca|en)\//, '')}/`;
const eur = (n: number) => (lang === 'en' ? `€${n}` : `${n} €`);

const retratoAvif = await getImage({ src: retrato, format: 'avif', widths: [320, 480, 640], quality: 60 });
const retratoWebp = await getImage({ src: retrato, format: 'webp', widths: [320, 480, 640], quality: 70 });
const retratoJpg = await getImage({ src: retrato, format: 'jpeg', width: 640, quality: 75 });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: 'Margarita Margenat',
  alternateName: ['Margarita Psicología', 'Margarita Psicóloga Online'],
  description: t.meta.description,
  image: `${site}/margarita.jpeg`,
  url: `${site}${base(lang)}`,
  email: EMAIL,
  telephone: '+34639664982',
  priceRange: '€€',
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  areaServed: { '@type': 'Country', name: 'España' },
  availableLanguage: ['es', 'ca', 'en'],
  knowsAbout: ['ansiedad', 'autoestima', 'autoexigencia', 'relaciones', 'terapia online'],
  sameAs: [
    `https://instagram.com/${INSTAGRAM}`,
    'https://es.linkedin.com/in/margarita-margenat-puig-51896223a',
    'https://www.mundopsicologos.com/procard/margarita-margenat',
    'https://www.toppsicologos.com/barcelona/psicologos/margarita-margenat',
  ],
  makesOffer: precios.flatMap((p) =>
    p.variants.filter((v) => v.price).map((v) => ({
      '@type': 'Offer', price: String(v.price), priceCurrency: 'EUR',
      itemOffered: { '@type': 'Service', name: `Sesión de terapia online · ${v.dur.es}`, serviceType: 'Terapia online' },
    }))
  ),
};
---
<Base lang={lang} t={t} title={t.meta.title} description={t.meta.description} shareTitle={t.meta.shareTitle} shareDescription={t.meta.shareDescription} hero jsonLd={jsonLd}>

  <!-- 1 · Cartel -->
  <section class="hero" id="inicio">
    <div class="hero-media" aria-hidden="true">
      <picture>
        <source media="(max-width: 900px)" type="image/avif" srcset={tallAvif.srcSet.attribute} sizes="100vw" />
        <source media="(max-width: 900px)" type="image/webp" srcset={tallWebp.srcSet.attribute} sizes="100vw" />
        <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes="100vw" />
        <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes="100vw" />
        <img src={wideJpg.src} width={wideJpg.attributes.width} height={wideJpg.attributes.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="wrap hero-inner">
      <span class="caps hero-kicker">{t.hero.kicker}</span>
      <h1 class="hero-title">{t.hero.t1}<em>{t.hero.em}</em>{t.hero.t2}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <a href={wa} target="_blank" rel="noopener" class="btn btn-light">{t.hero.cta}</a>
        <a href="#empezamos" class="link link-light">{t.hero.cta2}</a>
      </div>
    </div>
  </section>

  <!-- 2 · ¿Te reconoces? -->
  <section class="block" id="reconoces">
    <div class="wrap narrow">
      <h2 class="title">{t.reconoces.title}</h2>
      <ul class="lines">
        {t.reconoces.items.map((it) => (
          <li class={it.href ? 'go' : undefined}>
            {it.href
              ? <a href={it.href}><span class="caps">{it.tag}</span><p>{it.text}</p><span class="arrow" aria-hidden="true">&rarr;</span></a>
              : <><span class="caps">{it.tag}</span><p>{it.text}</p></>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · La frase -->
  <section class="block sky statement" id="enfoque">
    <div class="wrap narrow">
      <p class="big">{t.statement.big}</p>
      <p class="em">{t.statement.em}</p>
      <p class="close">{t.statement.close}</p>
      <a href={wa} target="_blank" rel="noopener" class="btn btn-primary">{t.statement.cta}</a>
    </div>
  </section>

  <!-- 4 · Margarita -->
  <section class="block sand" id="margarita">
    <div class="wrap narrow about">
      <picture>
        <source type="image/avif" srcset={retratoAvif.srcSet.attribute} sizes="(max-width: 600px) 70vw, 320px" />
        <source type="image/webp" srcset={retratoWebp.srcSet.attribute} sizes="(max-width: 600px) 70vw, 320px" />
        <img src={retratoJpg.src} alt={t.sobremi.alt} width={retratoJpg.attributes.width} height={retratoJpg.attributes.height} loading="lazy" decoding="async" />
      </picture>
      <div>
        <h2 class="title">{t.sobremi.title}</h2>
        <p>{t.sobremi.p1}</p>
      </div>
    </div>
  </section>

  <!-- 5 · Cómo empezamos + tarifas -->
  <section class="block" id="empezamos">
    <div class="wrap narrow">
      <h2 class="title">{t.empezamos.title}</h2>
      <ul class="lines">
        {t.empezamos.steps.map((s) => <li><p>{s}</p></li>)}
      </ul>
      <h3 class="subtitle">{t.empezamos.tarifas}</h3>
      <dl class="prices">
        {precios.flatMap((p) => p.variants.length > 1
          ? [
              <div class="group"><dt>{p.name[lang]}</dt></div>,
              ...p.variants.map((v) => (
                <div class="sub">
                  <dt>{v.dur[lang]}</dt>
                  <dd>{v.price ? eur(v.price) : <em>{('note' in v && v.note) ? v.note[lang] : t.empezamos.consult}</em>}</dd>
                </div>
              )),
            ]
          : p.variants.map((v) => (
              <div>
                <dt>{p.name[lang]} <span>· {v.dur[lang]}</span></dt>
                <dd>{v.price ? eur(v.price) : <em>{('note' in v && v.note) ? v.note[lang] : t.empezamos.consult}</em>}</dd>
              </div>
            ))
        )}
      </dl>
      <p class="prices-note">{t.empezamos.note}</p>
    </div>
  </section>

  <!-- 6 · Encuentros -->
  {encuentros.length > 0 && (
    <section class="block sand encuentros-home" id="encuentros">
      <div class="wrap narrow">
        <h2 class="title">{t.encuentros.title}</h2>
        <p class="intro">{t.encuentros.intro}</p>
        <ul class="encuentros">
          {encuentros.map((e) => {
            const d = e.data; const href = encHref(e); const ext = Boolean(d.url);
            return (
              <li>
                <a href={href} class="cover" target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
                  <EncuentroFoto file={d.cover} alt="" sizes="(max-width: 600px) 100vw, 300px" width={800} />
                </a>
                <div class="body">
                  <span class="caps">{d.upcoming ? `${t.encuentros.upcoming} · ` : ''}{d.kicker}</span>
                  <h3><a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{d.title}</a></h3>
                  <p class="when">{d.when}</p>
                  <a href={href} class="link" target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{ext ? t.encuentros.external : t.encuentros.open}</a>
                </div>
              </li>
            );
          })}
        </ul>
        <p class="more"><a href={`${home}encuentros/`} class="link">{t.encuentros.all}</a></p>
      </div>
    </section>
  )}

  <!-- 7 · Recursos -->
  <section class="block" id="recursos">
    <div class="wrap narrow">
      <h2 class="title">{t.recursos.title}</h2>
      <ul class="resources">
        {recursos.map((r) => (
          <li>
            <span class="caps">{r.data.kind[lang]}{r.data.duration ? ` · ${r.data.duration}` : ''}{r.data.lang !== lang && t.recursos.inLang ? ` · ${t.recursos.inLang}` : ''}</span>
            <h3><a href={`${base(r.data.lang)}recursos/${r.id}/`}>{r.data.title}</a></h3>
            <p>{r.data.summary[lang]}</p>
            <a href={`${base(r.data.lang)}recursos/${r.id}/`} class="link">{r.data.audio ? t.recursos.listen : t.recursos.read}</a>
          </li>
        ))}
      </ul>
      <p class="more"><a href={`${home}recursos/`} class="link">{t.recursos.all}</a></p>
    </div>
  </section>

  <!-- Cierre -->
  <section class="block sea cierre" id="contacto">
    <div class="wrap narrow">
      <h2 class="title">{t.cierre.title}</h2>
      <p>{t.cierre.sub}</p>
      <a href={wa} target="_blank" rel="noopener" class="btn btn-light"><WhatsAppIcon /> {t.cierre.cta}</a>
    </div>
  </section>

</Base>
