---
// Home "Cielo" (boceto de gurí elegido por Lucía el 02-11-2026, maqueta en _lab/bocetos/cielo.html):
// toda la página es un solo cielo del amanecer a la noche; la gaviota del logo vuela en la portada y la luna
// de Margarita cierra. Estilos en src/styles/cielo.css (solo con body.cielo); las interiores siguen en papel y tinta.
import '../styles/cielo.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gull from './Gull.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { base, byNewest, dicts, waLink, EMAIL, INSTAGRAM, type Lang } from '../i18n';
import precios from '../data/precios.json';
import luna from '../assets/luna.jpg';
import retrato from '../assets/margarita.jpeg';
import { getCollection } from 'astro:content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const home = base(lang);
const recursos = (await getCollection('recursos')).sort(byNewest).slice(0, 4);

// Margarita: retrato redondo (se pinta en blanco y negro fundido con el cielo).
const retratoAvif = await getImage({ src: retrato, format: 'avif', widths: [420, 640, 840], sizes: '(max-width: 900px) 100vw, 420px', quality: 60 });
const retratoWebp = await getImage({ src: retrato, format: 'webp', widths: [420, 640, 840], sizes: '(max-width: 900px) 100vw, 420px', quality: 70 });
const retratoJpg = await getImage({ src: retrato, format: 'jpeg', width: 840, quality: 75 });
// Cierre: la luna sobre el pino, a pantalla completa.
const lunaAvif = await getImage({ src: luna, format: 'avif', widths: [800, 1400, 2000], sizes: '100vw', quality: 52 });
const lunaWebp = await getImage({ src: luna, format: 'webp', widths: [800, 1400, 2000], sizes: '100vw', quality: 68 });
const lunaJpg = await getImage({ src: luna, format: 'jpg', width: 1600, quality: 72 });

const site = Astro.site!.toString().replace(/\/$/, '');
const wa = waLink(t.wa.msg);
const eur = (n: number) => (lang === 'en' ? `€${n}` : `${n} €`);

// Encuentros (talleres y retiros) en el idioma de la página: próximos primero. Cada uno es un cuadro de color
// con su marca: la hoguera del retiro, el "Mírate con amor" escrito a mano; cualquier otro, su nombre en Young Serif.
const encuentros = (await getCollection('encuentros'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => Number(b.data.upcoming) - Number(a.data.upcoming) || byNewest(a, b));
const slugOf = (e: (typeof encuentros)[number]) => e.id.replace(/^(ca|en)\//, '');
const encHref = (e: (typeof encuentros)[number]) => e.data.url ?? `${home}encuentros/${slugOf(e)}/`;
const marca = (slug: string) => (slug === 'presencia-y-celebracion' ? 'retiro' : slug === 'mirate-con-amor' ? 'mirate' : 'otro');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: 'Margarita Margenat',
  alternateName: ['Margarita Psicología', 'Margarita Psicóloga Online'],
  description: t.meta.description,
  image: `${site}/margarita.jpeg`,
  url: `${site}${base(lang)}`,
  email: EMAIL,
  telephone: '+34639664982',
  priceRange: '€€',
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  areaServed: { '@type': 'Country', name: 'España' },
  availableLanguage: ['es', 'ca', 'en'],
  knowsAbout: ['ansiedad', 'autoestima', 'autoexigencia', 'relaciones', 'terapia online'],
  sameAs: [
    `https://instagram.com/${INSTAGRAM}`,
    'https://es.linkedin.com/in/margarita-margenat-puig-51896223a',
    'https://www.mundopsicologos.com/procard/margarita-margenat',
    'https://www.toppsicologos.com/barcelona/psicologos/margarita-margenat',
  ],
  makesOffer: precios.flatMap((p) =>
    p.variants.filter((v) => v.price).map((v) => ({
      '@type': 'Offer', price: String(v.price), priceCurrency: 'EUR',
      itemOffered: { '@type': 'Service', name: `Sesión de terapia online · ${v.dur.es}`, serviceType: 'Terapia online' },
    }))
  ),
};
---
<Base lang={lang} t={t} title={t.meta.title} description={t.meta.description} shareTitle={t.meta.shareTitle} shareDescription={t.meta.shareDescription} jsonLd={jsonLd} cielo>

  <!-- 1 · Portada: la gaviota vuela arriba; el título enorme y ligero -->
  <section class="hero" id="inicio">
    <Gull class="gaviota" />
    <div class="cw">
      <p class="k">{t.hero.kicker}</p>
      <h1>{t.hero.t1}<em>{t.hero.em}</em>{t.hero.t2}</h1>
      <p class="sub">{t.hero.sub}</p>
      <a href={wa} target="_blank" rel="noopener" class="cbtn">{t.hero.cta}</a>
    </div>
  </section>

  <!-- 2 · ¿Te reconoces? -->
  <section class="rec" id="reconoces">
    <div class="cw">
      <h2>{t.reconoces.title}</h2>
      {t.reconoces.items.map((it) => (
        <a href={it.href ?? `${home}#contacto`}><small>{it.tag}</small><span>{it.text}</span></a>
      ))}
    </div>
  </section>

  <!-- 3 · La frase -->
  <section class="frase" id="enfoque">
    <div class="cw">
      <p>{t.statement.big} <em>{t.statement.em}</em></p>
      <p class="c">{t.statement.close}</p>
    </div>
  </section>

  <!-- 4 · Margarita -->
  <section class="yo" id="margarita">
    <div class="cw">
      <picture>
        <source type="image/avif" srcset={retratoAvif.srcSet.attribute} sizes="(max-width: 900px) 100vw, 420px" />
        <source type="image/webp" srcset={retratoWebp.srcSet.attribute} sizes="(max-width: 900px) 100vw, 420px" />
        <img src={retratoJpg.src} alt={t.sobremi.alt} width={retratoJpg.attributes.width} height={retratoJpg.attributes.height} loading="lazy" decoding="async" />
      </picture>
      <div><h2>{t.sobremi.title}</h2><p>{t.sobremi.p1}</p></div>
    </div>
  </section>

  <!-- 5 · Cómo empezamos y tarifas -->
  <section class="pasos" id="empezamos">
    <div class="cw">
      <h2>{t.empezamos.title}</h2>
      <div>
        <ol>{t.empezamos.steps.map((s) => <li>{s}</li>)}</ol>
        <div class="tarifa" id="tarifas">
          <h3>{t.empezamos.tarifas}</h3>
          {precios.flatMap((p) => p.variants.map((v, i) => (
            <div class="fila">
              <span>{i > 0 ? v.dur[lang] : v.price ? `${p.name[lang]} · ${v.dur[lang]}` : p.name[lang]}</span>
              {v.price ? <span>{eur(v.price)}</span> : <span class="n">{('note' in v && v.note) ? v.note[lang] : t.empezamos.consult}</span>}
            </div>
          )))}
          <p class="nota">{t.empezamos.note}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · Encuentros: cuadros de color, cada uno con su marca -->
  {encuentros.length > 0 && (
    <section class="enc" id="encuentros">
      <div class="cw">
        <h2>{t.encuentros.title}</h2>
        <p class="i">{t.encuentros.intro}</p>
        <div class="g">
          {encuentros.map((e) => {
            const d = e.data; const href = encHref(e); const ext = Boolean(d.url); const m = marca(slugOf(e));
            return (
              <figure>
                <a class={`cuadro c-${m}`} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} aria-label={d.title}>
                  {m === 'retiro' && (
                    <>
                      <svg viewBox="50 36 100 112" width="96" height="108" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M62,138 L140,120 M60,122 L138,140 M100,144 L100,128" stroke="#1f2a3a" stroke-width="7"/><path d="M100,112 C84,100 82,84 92,70 C92,82 98,86 100,92 C104,80 100,66 110,54 C112,74 124,80 124,98 C124,108 114,118 100,118 C92,118 86,112 86,104" stroke="#d9408c" stroke-width="7"/><circle cx="120" cy="44" r="4" fill="#d9408c"/><circle cx="84" cy="52" r="3.2" fill="#d9408c"/><circle cx="130" cy="62" r="3" fill="#d9408c"/></svg>
                      <p class="marca">{d.title}</p>
                    </>
                  )}
                  {m === 'mirate' && (
                    <svg viewBox="0 0 260 120" aria-hidden="true"><text x="130" y="60" text-anchor="middle" fill="currentColor" font-family="Caveat" font-weight="700" font-size="74">Mírate</text><text x="130" y="100" text-anchor="middle" fill="currentColor" font-family="Caveat" font-weight="500" font-size="40">con amor</text><path d="M42,70 C90,64 170,76 222,66" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>
                  )}
                  {m === 'otro' && <p class="marca">{d.title}</p>}
                </a>
                <figcaption><span class="tipo">{d.kicker}</span><span class="dato"><span>{d.title}</span><span>{d.when}</span></span></figcaption>
              </figure>
            );
          })}
        </div>
        <p class="todos"><a href={`${home}encuentros/`}>{t.encuentros.all}</a></p>
      </div>
    </section>
  )}

  <!-- 7 · Recursos: los últimos -->
  <section class="recu" id="recursos">
    <div class="cw">
      <div><h2>{t.recursos.title}</h2><p class="s">{t.recursos.short}</p></div>
      <div>
        <ul>
          {recursos.map((r) => (
            <li><a href={`${base(r.data.lang)}recursos/${r.id}/`}>
              <span>{r.data.title}{r.data.duration ? ` · ${r.data.duration}` : ''}</span>
              <small>{r.data.audio ? t.recursos.listen : t.recursos.read}</small>
            </a></li>
          ))}
        </ul>
        <p class="todos"><a href={`${home}recursos/`}>{t.recursos.all}</a></p>
      </div>
    </div>
  </section>

  <!-- 8 · Cierre: la luna -->
  <section class="fin" id="contacto">
    <picture aria-hidden="true">
      <source type="image/avif" srcset={lunaAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={lunaWebp.srcSet.attribute} sizes="100vw" />
      <img src={lunaJpg.src} width={lunaJpg.attributes.width} height={lunaJpg.attributes.height} alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="cw">
      <h2>{t.cierre.title}</h2>
      <p>{t.cierre.sub}</p>
      <a href={wa} target="_blank" rel="noopener" class="cbtn"><WhatsAppIcon /> {t.cierre.cta}</a>
    </div>
  </section>

</Base>
