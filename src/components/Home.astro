---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import EncuentroFoto from './EncuentroFoto.astro';
import { base, byNewest, dicts, waLink, EMAIL, INSTAGRAM, type Lang } from '../i18n';
import precios from '../data/precios.json';
import luna from '../assets/luna.jpg';
import lunaMovil from '../assets/luna-movil.jpg'; // recorte cuadrado para móvil: se carga solo lo que se ve
import cielo from '../assets/hero-wide.jpg';
import retrato from '../assets/margarita.jpeg';
import { getCollection } from 'astro:content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const home = base(lang);
const recursos = (await getCollection('recursos')).sort(byNewest).slice(0, 3);

// Portada: la luna sobre el pino (foto de Margarita), a media pantalla en escritorio y bajo el texto en móvil.
const SZ_DESK = '(max-width: 900px) 0px, 50vw';
const lunaAvif = await getImage({ src: luna, format: 'avif', widths: [640, 1000, 1400], sizes: SZ_DESK, quality: 52 });
const lunaWebp = await getImage({ src: luna, format: 'webp', widths: [640, 1000, 1400], sizes: SZ_DESK, quality: 68 });
const lunaJpg  = await getImage({ src: luna, format: 'jpg', width: 1000, quality: 72 });
const SZ_MOV = '100vw';
const movilAvif = await getImage({ src: lunaMovil, format: 'avif', widths: [480, 720, 960], sizes: SZ_MOV, quality: 50 });
const movilWebp = await getImage({ src: lunaMovil, format: 'webp', widths: [480, 720, 960], sizes: SZ_MOV, quality: 66 });
// Precarga de la foto de portada (es el elemento más grande que se pinta): una versión por tamaño de pantalla.
const preload = [
  { imagesrcset: movilAvif.srcSet.attribute, imagesizes: SZ_MOV, media: '(max-width: 900px)', type: 'image/avif' },
  { imagesrcset: lunaAvif.srcSet.attribute, imagesizes: '50vw', media: '(min-width: 901px)', type: 'image/avif' },
];
// Pausa: el cielo con la gaviota.
const cieloAvif = await getImage({ src: cielo, format: 'avif', widths: [800, 1400, 2000], sizes: '100vw', quality: 55 });
const cieloWebp = await getImage({ src: cielo, format: 'webp', widths: [800, 1400, 2000], sizes: '100vw', quality: 70 });
const cieloJpg  = await getImage({ src: cielo, format: 'jpg', width: 1600, quality: 72 });
// Margarita
const retratoAvif = await getImage({ src: retrato, format: 'avif', widths: [400, 600, 776], quality: 60 });
const retratoWebp = await getImage({ src: retrato, format: 'webp', widths: [400, 600, 776], quality: 70 });
const retratoJpg = await getImage({ src: retrato, format: 'jpeg', width: 776, quality: 75 });

const site = Astro.site!.toString().replace(/\/$/, '');
const wa = waLink(t.wa.msg);
const eur = (n: number) => (lang === 'en' ? `€${n}` : `${n} €`);

// Encuentros (talleres y retiros) en el idioma de la página: próximos primero. Las fotos van a su proporción,
// con cada columna tan ancha como pide su foto para que queden a la misma altura.
const encuentros = (await getCollection('encuentros'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => Number(b.data.upcoming) - Number(a.data.upcoming) || byNewest(a, b));
const encHref = (e: (typeof encuentros)[number]) => e.data.url ?? `${home}encuentros/${e.id.replace(/^(ca|en)\//, '')}/`;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/encuentro-*.jpg', { eager: true });
const encCols = encuentros.map((e) => { const m = fotos[`../assets/${e.data.cover}`]?.default; return m ? `minmax(0, ${(m.width / m.height).toFixed(3)}fr)` : 'minmax(0, 1fr)'; }).join(' ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: 'Margarita Margenat',
  alternateName: ['Margarita Psicología', 'Margarita Psicóloga Online'],
  description: t.meta.description,
  image: `${site}/margarita.jpeg`,
  url: `${site}${base(lang)}`,
  email: EMAIL,
  telephone: '+34639664982',
  priceRange: '€€',
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  areaServed: { '@type': 'Country', name: 'España' },
  availableLanguage: ['es', 'ca', 'en'],
  knowsAbout: ['ansiedad', 'autoestima', 'autoexigencia', 'relaciones', 'terapia online'],
  sameAs: [
    `https://instagram.com/${INSTAGRAM}`,
    'https://es.linkedin.com/in/margarita-margenat-puig-51896223a',
    'https://www.mundopsicologos.com/procard/margarita-margenat',
    'https://www.toppsicologos.com/barcelona/psicologos/margarita-margenat',
  ],
  makesOffer: precios.flatMap((p) =>
    p.variants.filter((v) => v.price).map((v) => ({
      '@type': 'Offer', price: String(v.price), priceCurrency: 'EUR',
      itemOffered: { '@type': 'Service', name: `Sesión de terapia online · ${v.dur.es}`, serviceType: 'Terapia online' },
    }))
  ),
};
---
<Base lang={lang} t={t} title={t.meta.title} description={t.meta.description} shareTitle={t.meta.shareTitle} shareDescription={t.meta.shareDescription} jsonLd={jsonLd} preload={preload}>

  <!-- 1 · Portada partida: texto sobre papel, la cala al lado -->
  <section class="hero" id="inicio">
    <div class="hero-text">
      <span class="caps hero-kicker">{t.hero.kicker}</span>
      <h1 class="hero-title">{t.hero.t1}<em>{t.hero.em}</em>{t.hero.t2}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div><a href={wa} target="_blank" rel="noopener" class="btn btn-primary">{t.hero.cta}</a></div>
    </div>
    <div class="hero-photo">
      <picture>
        <source media="(max-width: 900px)" type="image/avif" srcset={movilAvif.srcSet.attribute} sizes={SZ_MOV} />
        <source media="(max-width: 900px)" type="image/webp" srcset={movilWebp.srcSet.attribute} sizes={SZ_MOV} />
        <source type="image/avif" srcset={lunaAvif.srcSet.attribute} sizes="50vw" />
        <source type="image/webp" srcset={lunaWebp.srcSet.attribute} sizes="50vw" />
        <img src={lunaJpg.src} width={lunaJpg.attributes.width} height={lunaJpg.attributes.height} alt={t.hero.alt} loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </div>
  </section>

  <!-- 2 · ¿Te reconoces? -->
  <section class="block" id="reconoces">
    <div class="wrap">
      <h2 class="title">{t.reconoces.title}</h2>
      <ul class="lines">
        {t.reconoces.items.map((it) => (
          <li class={it.href ? 'go' : undefined}>
            {it.href
              ? <a href={it.href}><span class="caps">{it.tag}</span><p>{it.text}</p><span class="arrow" aria-hidden="true">&rarr;</span></a>
              : <><span class="caps">{it.tag}</span><p>{it.text}</p></>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · La frase, sobre el cielo -->
  <section class="pause" id="enfoque">
    <picture class="pause-media" aria-hidden="true">
      <source type="image/avif" srcset={cieloAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={cieloWebp.srcSet.attribute} sizes="100vw" />
      <img src={cieloJpg.src} width={cieloJpg.attributes.width} height={cieloJpg.attributes.height} alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="wrap"><div class="pause-in">
      <p class="big">{t.statement.big}</p>
      <p class="em">{t.statement.em}</p>
      <p class="close">{t.statement.close}</p>
      <a href={wa} target="_blank" rel="noopener" class="btn btn-ghost">{t.statement.cta}</a>
    </div></div>
  </section>

  <!-- 4 · Margarita -->
  <section class="block about" id="margarita">
    <div class="wrap">
      <picture>
        <source type="image/avif" srcset={retratoAvif.srcSet.attribute} sizes="(max-width: 900px) 100vw, 460px" />
        <source type="image/webp" srcset={retratoWebp.srcSet.attribute} sizes="(max-width: 900px) 100vw, 460px" />
        <img src={retratoJpg.src} alt={t.sobremi.alt} width={retratoJpg.attributes.width} height={retratoJpg.attributes.height} loading="lazy" decoding="async" />
      </picture>
      <div>
        <span class="caps">{t.nav.sobremi}</span>
        <h2 class="title">{t.sobremi.title}</h2>
        <p>{t.sobremi.p1}</p>
        <a href="#empezamos" class="lnk">{t.nav.empezamos}</a>
      </div>
    </div>
  </section>

  <!-- 5 · Cómo empezamos -->
  <section class="block side start" id="empezamos">
    <div class="wrap">
      <h2 class="title">{t.empezamos.title}</h2>
      <ul class="steps">
        {t.empezamos.steps.map((s) => <li><p>{s}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- 6 · Tarifas -->
  <section class="block side fees" id="tarifas">
    <div class="wrap">
      <h2 class="title">{t.empezamos.tarifas}</h2>
      <div>
        <dl class="prices">
          {precios.flatMap((p) => p.variants.length > 1
            ? [
                <div class="group"><dt>{p.name[lang]}</dt></div>,
                ...p.variants.map((v) => (
                  <div class="sub">
                    <dt>{v.dur[lang]}</dt>
                    <dd>{v.price ? eur(v.price) : <em>{('note' in v && v.note) ? v.note[lang] : t.empezamos.consult}</em>}</dd>
                  </div>
                )),
              ]
            : p.variants.map((v) => (
                <div>
                  <dt>{p.name[lang]} <span>· {v.dur[lang]}</span></dt>
                  <dd>{v.price ? eur(v.price) : <em>{('note' in v && v.note) ? v.note[lang] : t.empezamos.consult}</em>}</dd>
                </div>
              ))
          )}
        </dl>
        <p class="prices-note">{t.empezamos.note}</p>
      </div>
    </div>
  </section>

  <!-- 7 · Encuentros -->
  {encuentros.length > 0 && (
    <section class="block side meet" id="encuentros">
      <div class="wrap">
        <div>
          <h2 class="title">{t.encuentros.title}</h2>
          <p class="lead">{t.encuentros.intro}</p>
        </div>
        <div>
          <div class="strip" style={`grid-template-columns: ${encCols}`}>
            {encuentros.map((e) => {
              const d = e.data; const href = encHref(e); const ext = Boolean(d.url);
              return (
                <figure>
                  <a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                    <EncuentroFoto file={d.cover} alt={d.coverAlt} sizes="(max-width: 900px) 60vw, 420px" width={900} />
                  </a>
                  <figcaption>
                    <a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{d.title}</a>
                    <span>{d.kicker}</span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
          <p class="more"><a href={`${home}encuentros/`} class="lnk">{t.encuentros.all}</a></p>
        </div>
      </div>
    </section>
  )}

  <!-- 8 · Recursos: los tres últimos -->
  <section class="block side res" id="recursos">
    <div class="wrap">
      <div>
        <h2 class="title">{t.recursos.title}</h2>
        <p class="lead">{t.recursos.short}</p>
      </div>
      <div>
        <ul class="reslist">
          {recursos.map((r) => {
            const href = `${base(r.data.lang)}recursos/${r.id}/`;
            return (
              <li><a href={href}>
                <span><b>{r.data.title}</b><span class="caps">{r.data.kind[lang]}{r.data.duration ? ` · ${r.data.duration}` : ''}{r.data.lang !== lang && t.recursos.inLang ? ` · ${t.recursos.inLang}` : ''}</span></span>
                <span class="go">{r.data.audio ? t.recursos.listen : t.recursos.read}</span>
              </a></li>
            );
          })}
        </ul>
        <p class="more"><a href={`${home}recursos/`} class="lnk">{t.recursos.all}</a></p>
      </div>
    </div>
  </section>

  <!-- 9 · Cierre -->
  <section class="end" id="contacto">
    <div class="wrap">
      <h2>{t.cierre.title}</h2>
      <div class="row">
        <a href={wa} target="_blank" rel="noopener" class="btn btn-ghost"><WhatsAppIcon /> {t.cierre.cta}</a>
        <p>{t.cierre.sub}</p>
      </div>
    </div>
  </section>

</Base>
