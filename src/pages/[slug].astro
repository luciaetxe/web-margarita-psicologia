---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dicts, waLink, base } from '../i18n';

// Páginas de servicio (solo ES de momento): /psicologa-online-ansiedad/, /autoexigencia/, /terapia-online/
export async function getStaticPaths() {
  const items = await getCollection('servicios');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const lang = d.lang;
const t = dicts[lang];
const site = Astro.site!.toString().replace(/\/$/, '');
const home = base(lang);
const path = `${entry.id}/`;
const url = `${site}${home}${path}`;
const title = d.seoTitle ?? `${d.title} · Margarita Margenat`; // seoTitle va tal cual (≤ 60 caracteres)
const shareTitle = `${d.title} · Margarita Margenat`;
const description = d.summary;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    description,
    serviceType: 'Terapia online',
    url,
    inLanguage: lang,
    provider: { '@type': 'Psychologist', name: 'Margarita Margenat', url: `${site}${home}` },
    areaServed: { '@type': 'Country', name: 'España' },
    availableChannel: { '@type': 'ServiceChannel', serviceUrl: url, availableLanguage: ['es', 'ca', 'en'] },
  },
  d.faq.length > 0 && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Margarita Margenat', item: `${site}${home}` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
].filter(Boolean);
---
<Base lang={lang} t={t} title={title} shareTitle={shareTitle} description={description} path={path} single jsonLd={jsonLd}>
  <main class="wrap narrow resource">
    <nav class="crumbs" aria-label="Estás en">
      <a href={home}>Inicio</a><span>›</span><span aria-current="page">{d.title}</span>
    </nav>
    <span class="caps kicker">{d.kicker}</span>
    <h1>{d.title}</h1>
    <p class="lede">{description}</p>
    <Content />
    {d.faq.length > 0 && (
      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {d.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}
    <div class="actions">
      <a href={waLink(t.wa.msg)} target="_blank" rel="noopener" class="btn btn-primary">{t.hero.cta}</a>
      <a href={`${home}#empezamos`} class="link">{t.nav.empezamos}</a>
    </div>
    <p class="byline">— Margarita Margenat</p>
  </main>
</Base>
